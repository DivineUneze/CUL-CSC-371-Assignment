import csv
import random

departments = ["Computer Science", "Cyber Security", "Software Engineering", "Information Technology", "Data Science"]
levels = [100, 200, 300, 400]

# Create 50 fictional students
with open('student_dataset.csv', 'w', newline='') as file:
    writer = csv.writer(file)
    writer.writerow(["Student ID", "Department", "Level", "Attendance Percentage", "Average Examination Score"])
    
    for i in range(1, 51):
        student_id = f"CUL/{random.randint(20, 24)}/{1000 + i}"
        department = random.choice(departments)
        level = random.choice(levels)
        attendance = random.randint(55, 100)
        # Higher attendance = slightly higher score, to look realistic
        score = round(min(95, max(35, attendance * 0.7 + random.randint(-10, 15))), 1)
        
        writer.writerow([student_id, department, level, attendance, score])

print("Dataset created successfully: student_dataset.csv")